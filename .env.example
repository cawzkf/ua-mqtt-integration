# MQTT Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_ELECTRICAL=scgdi/motor/electrical
MQTT_TOPIC_VIBRATION=scgdi/motor/vibration
MQTT_TOPIC_ENVIRONMENT=scgdi/motor/environment

# OPC UA Configuration
OPCUA_ENDPOINT=opc.tcp://localhost:4840/freeopcua/server/
OPCUA_SERVER_NAME=Motor50CV_OPCUA
OPCUA_APPLICATION_URI=urn:motor50cv:digitaltwin
OPCUA_MANUFACTURER_NAME=OPCUA
OPCUA_PRODUCT_NAME=Motor50CV Digital Twin

# MongoDB Configuration
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=motor50cv_history
MONGODB_USERNAME=admin
MONGODB_PASSWORD=password123

# LDS Discovery
LDS_ENDPOINT=opc.tcp://localhost:4840/UADiscovery
LDS_REGISTER_INTERVAL=10

# Monitoring Configuration
VOLTAGE_NOMINAL=220.0
VOLTAGE_TOLERANCE=0.1
CURRENT_NOMINAL=10.5
CURRENT_TOLERANCE=0.1
TEMPERATURE_CRITICAL=60.0
EVENT_CHECK_INTERVAL=5
HISTORY_SAVE_INTERVAL=10

# Docker specific
PYTHONPATH=/app
PYTHONUNBUFFERED=1
